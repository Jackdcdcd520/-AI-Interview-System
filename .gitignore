# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- 运行时产生的私有/本机数据（严禁提交）----
# 本机覆盖配置（可能包含 API Key 或私人路径）
config/settings.json

# 真实简历 / 数据库 / 面试数据（默认在数据目录，若放项目内也必须排除）
.cache/
data/
database/
uploads/
*.db
*.sqlite
*.sqlite3

# 简历原件与转换缓存
*.docx.bak
Resumes/
resumes/

# 测试产物：运行报告与截图可能包含真实候选人信息
tests/screenshots/
tests/*_report.json

# 日志
logs/
*.log

# ---- 环境变量（若使用 .env 方式管理密钥）----
.env
.env.*
!.env.example

# ---- IDE / 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Vite 临时产物 ----
*.timestamp-*.mjs
